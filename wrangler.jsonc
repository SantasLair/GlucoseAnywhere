{
  // Cloudflare Worker that serves the static web app in web/ (including web/_headers).
  // Deploy: npx wrangler deploy   (Cloudflare also runs this on every push to master)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glucoseanywhere",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web"
  },
  // Keep the glucoseanywhere.<account>.workers.dev address and preview URLs working for testing.
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "glucoseanywhere.com", "custom_domain": true },
    { "pattern": "www.glucoseanywhere.com", "custom_domain": true }
  ]
}
