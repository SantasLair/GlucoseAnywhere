{
  // Tiny Worker that redirects www.glucoseanywhere.com to the bare domain.
  // Deploy from this folder: npx wrangler deploy
  "name": "glucoseanywhere-www-redirect",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "www.glucoseanywhere.com", "custom_domain": true }
  ]
}
