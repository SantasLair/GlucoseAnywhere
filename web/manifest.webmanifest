{
  "name": "GlucoseAnywhere",
  "short_name": "GlucoseAnywhere",
  "description": "See your Dexcom glucose reading in any browser. Everything stays on your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#16181D",
  "theme_color": "#16181D",
  "shortcuts": [
    {
      "name": "Big display",
      "short_name": "Big display",
      "url": "./#big"
    },
    {
      "name": "Chart display",
      "short_name": "Chart",
      "url": "./#chart"
    }
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
